	string "Program name"
	default "xiaozhi_ui"

config LVX_CONTEST2026_307_XIAOZHI_UI_PRIORITY
	int "Task priority"
	default 100

config LVX_CONTEST2026_307_XIAOZHI_UI_STACKSIZE
	int "Stack size"
	default 16384

endif
